# Variables de entorno del kit Hefesto Tiempo · Kimai.
# Este archivo documenta las variables que consume compose.yaml y
# compose.bootstrap.yaml. No contiene secretos: cópielo a `.env` (permisos
# 0600) o, en Coolify, copie cada nombre al entorno del recurso con su
# valor real.
#
# scripts/configure.py crea un .env con valores reales; este .env.example
# solo enumera los nombres y describe su uso.

# Prefijo de los volúmenes nombrados. Coolify pone el nombre de proyecto
# automáticamente; cámbielo solo si comparte el VPS con otra instalación
# para evitar colisión de volúmenes.
VOLUME_PREFIX=hefesto-tiempo

# Secreto de sesiones de Kimai (framework.secret). Genere uno con
# `openssl rand -hex 32`. No reutilice entre entornos.
APP_SECRET=cambie-este-secreto-en-produccion

# Claves de MariaDB. El usuario `kimai` usa DB_PASSWORD; root usa
# DB_ROOT_PASSWORD. Genere ambas con `openssl rand -hex 32`.
DB_PASSWORD=cambie-esta-clave-en-produccion
DB_ROOT_PASSWORD=cambie-esta-clave-en-produccion

# Correo del administrador inicial. Combinado con compose.bootstrap.yaml
# crea el usuario `admin` solo si no existe.
ADMINMAIL=admin@ejemplo.cl

# Hosts válidos para Symfony (regex). Debe incluir el dominio real
# además de localhost y 127.0.0.1 para que el healthcheck funcione.
TRUSTED_HOSTS=^(localhost|127[.]0[.]0[.]1|mi-dominio[.]cl)$

# Proxies cuyos X-Forwarded-* se aceptan. Por defecto cubre la red
# Docker típica de Coolify (172.16.0.0/12). Inspeccione la red del
# contenedor si su Coolify usa otra subred.
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

# Transporte de correo. Por defecto, desactivado (null://localhost).
# Para activar SMTP use `smtp://user:pass@host:port?encryption=tls`.
MAILER_URL=null://localhost

# Opcional, solo para el primer arranque con compose.bootstrap.yaml.
# Tras crear el admin, recree el servicio solo con compose.yaml y borre
# esta variable del entorno.
ADMINPASS=cambie-esta-clave-inicial
